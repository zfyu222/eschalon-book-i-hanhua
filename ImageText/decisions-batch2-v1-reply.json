    {
      "id": "3",
      "status": "text",
      "reason": "对话Agent已查看证据图，逐项核对可见文字及区域。",
      "unreadable": false,
      "regions": [
        {
          "text": "Your quest ends in the west where you are able to buy a farm overlooking the eastern mountains bordering Thaermore.",
          "box": [
            45,
            0,
            950,
            155
          ]
        },
        {
          "text": "As the weeks pass, you watch the skies in the east turn dark. You hear talk in the local tavern that the Goblins continue to overtake the lands of Thaermore. The few humans who have escaped tell of the vicious Goblin raids that have brought down Blackwater and Bastion Spire. The Commonwealth Guards are powerless, the council has been disbanded and the Chancellor has disappeared.",
          "box": [
            45,
            210,
            950,
            555
          ]
        },
        {
          "text": "No one suspects what role you played in Thaermore's downfall, yet everyday you wonder if someone has become suspicious of your past. For now, you try not to worry about it.",
          "box": [
            45,
            610,
            950,
            815
          ]
        },
        {
          "text": "For now, life is good.",
          "box": [
            45,
            875,
            500,
            960
          ]
        }
      ]
    },
