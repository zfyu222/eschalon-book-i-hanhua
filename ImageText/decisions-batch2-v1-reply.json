      "id": "1",
      "status": "text",
      "reason": "对话Agent已查看证据图，逐项核对可见文字及区域。",
      "unreadable": false,
      "regions": [
        {
          "text": "You Have Died.",
          "box": [
            300,
            0,
            700,
            160
          ]
        },
        {
          "text": "As you fall to the ground, you suddenly feel your very essence ripped from the shell of your body. In an instance you find yourself standing on the precipice of eternity, an incoherent wailing emanating from the abyss below. You smile as you tumble forward into the black chasm.",
          "box": [
            0,
            190,
            1000,
            1000
          ]
        }
      ]
    },
